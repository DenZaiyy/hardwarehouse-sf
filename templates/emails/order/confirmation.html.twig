<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmation de votre commande {{ order.reference }}</title>
    {# Couleurs de la charte : primaire #064789, fond clair #ebf2fa, texte #212121, gris #4b5563 #}
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.5; color: #212121; max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { background-color: #064789; color: #ebf2fa; padding: 24px; border-radius: 8px 8px 0 0; }
        .header h1 { margin: 0; font-size: 22px; }
        .content { background-color: #ffffff; border: 1px solid #427aa1; border-top: 0; padding: 24px; border-radius: 0 0 8px 8px; }
        table { width: 100%; border-collapse: collapse; margin: 16px 0; }
        th { background-color: #ebf2fa; color: #064789; font-size: 12px; text-transform: uppercase; text-align: left; padding: 8px; }
        td { padding: 8px; border-bottom: 1px solid #dbe4ee; font-size: 14px; }
        .amount { text-align: right; white-space: nowrap; }
        .total td { font-weight: bold; color: #064789; border-bottom: 0; }
        .muted { color: #4b5563; font-size: 13px; }
        .button { display: inline-block; background-color: #064789; color: #ebf2fa; padding: 12px 20px; text-decoration: none; border-radius: 8px; }
    </style>
</head>
<body>
<div class="header">
    <h1>Merci pour votre commande !</h1>
</div>

<div class="content">
    <p>Bonjour {{ order.userFullNameSnapshot }},</p>
    <p>
        Votre paiement a bien été reçu : la commande <strong>{{ order.reference }}</strong> du
        {{ order.createdAt|date('d/m/Y') }} est confirmée. Nous vous écrirons à nouveau à son expédition.
    </p>

    <table>
        <thead>
            <tr>
                <th>Produit</th>
                <th>Quantité</th>
                <th class="amount">Total TTC</th>
            </tr>
        </thead>
        <tbody>
            {% for line in order.orderLines %}
                <tr>
                    <td>{{ line.productName }}</td>
                    <td>{{ line.quantity }}</td>
                    <td class="amount">{{ line.lineTotal|format_currency('EUR', locale = 'fr') }}</td>
                </tr>
            {% endfor %}
            <tr>
                <td colspan="2">Livraison</td>
                <td class="amount">{{ order.shippingAmount|format_currency('EUR', locale = 'fr') }}</td>
            </tr>
            <tr class="total">
                <td colspan="2">Total TTC</td>
                <td class="amount">{{ order.totalAmount|format_currency('EUR', locale = 'fr') }}</td>
            </tr>
        </tbody>
    </table>

    <p class="muted">
        Dont TVA : {{ order.taxAmount|format_currency('EUR', locale = 'fr') }}.
        Réglé par {{ order.paymentMethod.value == 'paypal' ? 'PayPal' : 'carte bancaire' }}.
    </p>

    {% set delivery = order.orderAddresses|filter(address => address.type and address.type.value == 'DELIVERY')|first %}
    {% if delivery %}
        <p>
            <strong>Livraison à :</strong><br>
            {{ delivery.firstName }} {{ delivery.lastName }}<br>
            {{ delivery.address }}<br>
            {{ delivery.postalCode }} {{ delivery.city }}<br>
            {{ delivery.country|country }}
        </p>
    {% endif %}

    {% if order.user %}
        <p style="text-align: center;">
            <a href="{{ url('order.show', {reference: order.reference, _locale: 'fr'}) }}" class="button">Suivre ma commande</a>
        </p>
    {% endif %}

    <p>À bientôt sur HardWareHouse.</p>
</div>
</body>
</html>
