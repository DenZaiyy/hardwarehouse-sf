{% extends 'base.html.twig' %}

{% block title %}{{ 'error.unavailable.title'|trans }} - HardWareHouse{% endblock %}

{% block body %}
    <div class="mx-auto my-12 flex max-w-2xl flex-col items-center gap-5 text-center">
        <h1>{{ 'error.unavailable.title'|trans }}</h1>
        <p class="text-muted">{{ 'error.unavailable.text'|trans }}</p>
        <a href="{{ path('homepage') }}" class="rounded-lg bg-primary px-6 py-2.5 font-title font-semibold text-paragraph no-underline hover:bg-primary-dark">
            {{ 'error.home'|trans }}
        </a>
    </div>
{% endblock %}
