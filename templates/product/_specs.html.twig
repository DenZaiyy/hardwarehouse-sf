{# Caractéristiques mises en forme par ProductSpecFormatter : libellé sans unité, valeur écrite pour le client #}
<table class="product-specs w-full text-sm">
    <tbody>
        {% for spec in specs %}
            <tr class="border-0 odd:bg-paragraph hover:bg-transparent odd:hover:bg-paragraph">
                <th scope="row" class="w-1/2 px-4 py-3 text-left text-sm font-normal normal-case tracking-normal text-muted md:w-1/4">{{ spec.label }}</th>
                <td class="px-4 py-3 font-semibold text-ink">{{ spec.value }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
