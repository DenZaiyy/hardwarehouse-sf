{# Lignes dans un cadre, fond alterné, comme la maquette #}
<div class="flex-1 overflow-hidden rounded-lg border border-secondary/30">
    {% for item in cart %}
        <div class="flex flex-wrap items-center gap-4 {% if not loop.last %}border-b border-secondary/30{% endif %} {% if loop.index is even %}bg-paragraph{% endif %} p-4">
            {% if item.imageUrl %}
                <img src="{{ item.imageUrl|catalog_image }}" alt="{{ item.name }}" loading="lazy" class="w-16 h-16 object-cover rounded">
            {% else %}
                <div class="w-16 h-16 bg-gray-100 rounded flex items-center justify-center text-muted text-xs">
                    {{ 'cart.line.no_image'|trans }}
                </div>
            {% endif %}

            <div class="flex-1">
                <a href="{{ path('product.show', {slug: item.slug}) }}" class="font-semibold text-sm text-black underline hover:no-underline duration-500 transition-all">{{ item.name }}</a>

                {% if item.promote and item.discount_price %}
                    <div class="flex items-center gap-2">
                        <strong class="text-sm text-black">{{ item.effective_ttc|format_currency('EUR') }}</strong>
                        <span class="text-xs text-muted line-through">{{ item.price_ttc|format_currency('EUR') }}</span>
                        <span class="rounded-full bg-red-100 px-1.5 py-0.5 text-xs font-semibold text-danger">
                            -{{ discount_rate(item.price_ht, item.effective_ht) }}%
                        </span>
                    </div>
                    <p class="text-muted text-xs">{{ 'cart.line.unit'|trans }}</p>
                {% else %}
                    <p class="text-muted text-sm"><strong>{{ item.price_ttc|format_currency('EUR') }}</strong> {{ 'cart.line.unit'|trans }}</p>
                {% endif %}

                <p class="text-sm text-secondary">{{ item.category }}</p>
            </div>

            <div class="ml-auto flex items-center gap-2">
                <form action="{{ path('cart.decrease', {productId: item.productId}) }}" method="POST">
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('cart') }}">
                    <button type="submit" class="rounded-md p-2 bg-primary" aria-label="{{ 'cart.line.decrease'|trans }}">{{ ux_icon('heroicons:minus', {class: 'size-5'}) }}</button>
                </form>
                <span class="min-w-6 p-2 text-center">{{ item.quantity }}</span>
                <form action="{{ path('cart.increase', {productId: item.productId}) }}" method="POST">
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('cart') }}">
                    <button type="submit" class="rounded-md p-2 bg-primary" aria-label="{{ 'cart.line.increase'|trans }}">{{ ux_icon('heroicons:plus', {class: 'size-5'}) }}</button>
                </form>

                {# Toujours visible, comme la maquette : sur ordinateur, il n'apparaissait qu'au survol de la ligne.
                   p-0 : la règle globale des boutons à icône (px-4) écrasait la croix dans un rond de 28 px #}
                <form action="{{ path('cart.remove', {productId: item.productId}) }}" method="POST" class="ml-2">
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('cart') }}">
                    <button type="submit" class="flex size-7 shrink-0 items-center justify-center rounded-full bg-danger p-0 text-white hover:bg-red-800" aria-label="{{ 'cart.line.remove'|trans }}">
                        {{ ux_icon('heroicons:x-mark', {class: 'size-4'}) }}
                    </button>
                </form>
            </div>
        </div>
    {% endfor %}
</div>
