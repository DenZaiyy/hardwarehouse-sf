<div {{ attributes }} class="grid grid-cols-1 gap-6 lg:grid-cols-[1fr_360px]">
    {% set state = this.state %}
    {% set totals = this.orderTotals %}

    <div class="space-y-4">
        {% include 'components/Checkout/steps/_step_identity.html.twig' with {
            state: state,
            form: form,
            loginError: this.loginError,
            lastUsername: this.lastUsername,
            isAuthenticatedStepSkipped: this.authenticatedStepSkipped
        } only %}

        {% include 'components/Checkout/steps/_step_address.html.twig' with {
            state: state,
            form: form,
            shouldShowAddressSelection: this.shouldShowAddressSelection,
            shouldShowAddressForm: this.shouldShowAddressForm,
            savedDeliveryAddresses: this.savedDeliveryAddresses,
            shouldShowBillingAddressSelection: this.shouldShowBillingAddressSelection,
            shouldShowBillingAddressForm: this.shouldShowBillingAddressForm,
            savedBillingAddresses: this.savedBillingAddresses
        } only %}

        {% include 'components/Checkout/steps/_step_delivery.html.twig' with {
            state: state,
            form: form,
            selectedCarrierLabel: this.selectedCarrierLabel
        } only %}

        {% include 'components/Checkout/steps/_step_payment.html.twig' with {
            state: state,
            availablePaymentMethods: this.availablePaymentMethods,
            selectedPaymentMethod: this.selectedPaymentMethod,
            paymentNotices: this.paymentNotices,
            orderTotal: totals.total
        } only %}
    </div>

    <div class="space-y-6">
        {% include 'components/Checkout/_cart_summary.html.twig' with {
            state: state,
            cartItems: this.cartItems,
            cartCount: this.cartCount,
            totals: totals
        } only %}
    </div>
</div>
