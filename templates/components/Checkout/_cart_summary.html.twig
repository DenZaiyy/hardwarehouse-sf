{# Montants TTC, la TVA incluse en dessous (B67, arrêté du 3 décembre 1987) : la maquette, antérieure, affichait du HT #}
<div class="space-y-4 rounded-lg bg-paragraph p-4">
    <h3 class="text-lg font-semibold text-primary">{{ 'checkout.summary.title'|trans }}</h3>

    {% if cartItems is not empty %}
        {# Cart Items #}
        <div class="space-y-3">
            <h4 class="font-medium text-ink">{{ 'checkout.summary.articles'|trans }} ({{ cartCount }})</h4>
            {% for item in cartItems %}
                <div class="flex justify-between items-start text-sm">
                    <div class="flex-1">
                        <div class="font-medium">{{ item.name }}</div>
                        <div class="text-muted">{{ 'checkout.summary.quantity'|trans({'%quantity%': item.quantity}) }}</div>
                        {% if item.promote and item.discount_amount %}
                            <span class="inline-flex items-center mt-1 rounded-full bg-red-100 px-2 py-0.5 text-xs font-semibold text-danger">
                    -{{ discount_rate(item.price_ht, item.effective_ht) }}%
                </span>
                        {% endif %}
                    </div>
                    <div class="text-right">
                        <div class="font-medium">{{ (item.effective_ttc * item.quantity)|format_currency('EUR') }}</div>
                        {% if item.promote %}
                            <div class="text-muted text-xs line-through">{{ (item.price_ttc * item.quantity)|format_currency('EUR') }}</div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>

        <hr class="border-secondary/30">

        {# Totals #}
        <div class="space-y-2">
            <div class="flex justify-between text-sm">
                <span>{{ 'checkout.summary.subtotal'|trans }}</span>
                <span>{{ totals.products_total|format_currency('EUR') }}</span>
            </div>
            {# Recalculée à chaque choix de transporteur : À choisir tant qu'aucun n'est retenu #}
            <div class="flex justify-between text-sm">
                <span>{{ 'checkout.summary.delivery'|trans }}</span>
                <span>{{ state.carrierId is null ? 'checkout.summary.delivery_pending'|trans : totals.carrier_cost|format_currency('EUR') }}</span>
            </div>
            <hr class="border-secondary/30">
            <div class="flex justify-between text-lg font-bold">
                <span>{{ 'checkout.summary.total'|trans }}</span>
                <span>{{ totals.total|format_currency('EUR') }}</span>
            </div>
            <div class="flex justify-between text-sm text-muted">
                <span>{{ 'checkout.summary.vat'|trans({'%rate%': (totals.vat_rate * 100)|round}) }}</span>
                <span>{{ totals.vat_amount|format_currency('EUR') }}</span>
            </div>
        </div>
    {% else %}
        <div class="text-center text-muted py-8">
            <p>{{ 'cart.empty'|trans }}</p>
            <a href="{{ path('product.index') }}" class="text-primary hover:underline">{{ 'checkout.summary.continue_shopping'|trans }}</a>
        </div>
    {% endif %}
</div>
