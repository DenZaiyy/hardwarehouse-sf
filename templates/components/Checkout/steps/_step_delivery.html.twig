{% import 'components/Checkout/steps/_macros.html.twig' as step %}
{% set status = not state.addressCompleted ? 'locked' : (state.deliveryCompleted and state.currentStep != 3 ? 'done' : (state.currentStep == 3 ? 'current' : 'locked')) %}
<section class="space-y-4 rounded-lg p-4 {{ status == 'current' ? 'border-2 border-primary' : 'border border-secondary/40' }}" data-step-status="{{ status }}">
    {{ step.header('checkout.step.delivery'|trans, status, 'editDelivery') }}

    {% if not state.addressCompleted %}
        {# Étape verrouillée : seul son titre s'affiche, comme la maquette #}
    {% elseif state.deliveryCompleted and state.currentStep != 3 %}
        <div class="text-sm">
            {{ selectedCarrierLabel ?? 'checkout.delivery.selected'|trans }}
        </div>
    {% elseif state.currentStep == 3 %}
        {{ form_start(form) }}
        <div class="space-y-3">
            {% if form.carrierId is defined %}
                <p class="font-medium">{{ 'checkout.delivery.choose'|trans }}</p>
                {% for child in form.carrierId %}
                    {% set carrier = carriers|filter(c => c.id == child.vars.value)|first %}
                    {# Une carte par transporteur, cliquable en entier. Le bouton radio garde ses attributs Live : le
                       choix enregistre le transporteur et le résumé recalcule la livraison et le total. font-normal :
                       la carte est un label, que la règle globale des formulaires met en gras #}
                    <label
                        for="{{ child.vars.id }}"
                        class="flex cursor-pointer flex-wrap items-center gap-4 rounded-lg p-4 font-normal transition-colors {{ child.vars.checked ? 'border-2 border-primary bg-paragraph' : 'border border-secondary/40 bg-white hover:border-primary' }}"
                    >
                        <input
                            type="radio"
                            id="{{ child.vars.id }}"
                            name="{{ child.vars.full_name }}"
                            value="{{ child.vars.value }}"
                            {% if child.vars.checked %}checked{% endif %}
                            data-action="change->live#action"
                            data-live-action-param="saveDeliveryChoice"
                            data-live-carrier-id-param="{{ child.vars.value }}"
                            class="size-5 shrink-0 accent-primary"
                        >
                        {% if carrier and carrier.logo %}
                            {# Décoratif : le nom du transporteur suit #}
                            <img src="{{ asset('uploads/images/carriers/' ~ carrier.logo) }}" alt="" loading="lazy" class="h-8 w-20 shrink-0 object-contain">
                        {% endif %}
                        <span class="min-w-40 flex-1">
                            <span class="block font-semibold text-ink">{{ carrier ? carrier.name : child.vars.label }}</span>
                            {% if carrier and carrier.description %}
                                {# Texte de l'éditeur de l'admin : affiché sans ses balises #}
                                <span class="block text-sm font-normal text-muted">{{ carrier.description|striptags }}</span>
                            {% endif %}
                        </span>
                        {% if carrier %}
                            <span class="font-semibold text-primary">{{ carrier.price|format_currency('EUR') }}</span>
                        {% endif %}
                    </label>
                {% endfor %}
            {% endif %}
        </div>
        {{ form_end(form, {render_rest: false}) }}
    {% endif %}
</section>
