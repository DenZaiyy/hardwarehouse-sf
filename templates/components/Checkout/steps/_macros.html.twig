{#
    En-tête commun des étapes du tunnel. L'état de l'étape (current, done, locked) fixe la couleur de son titre, comme la
    maquette. Une étape terminée porte son bouton Modifier à droite du titre, relié à l'action Live du composant
    (editIdentity, editAddress, editDelivery).
#}
{% macro header(title, status, editAction = null) %}
    <div class="flex items-center justify-between gap-4">
        <h2 class="text-lg font-semibold {{ status == 'locked' ? 'text-secondary' : 'text-primary' }}">{{ title }}</h2>
        {% if status == 'done' and editAction %}
            <button
                type="button"
                data-action="live#action"
                data-live-action-param="{{ editAction }}"
                class="border-2 border-primary bg-white px-5 py-2 text-primary hover:bg-paragraph"
            >
                {{ 'checkout.step.edit'|trans }}
            </button>
        {% endif %}
    </div>
{% endmacro %}
