{% import 'components/Checkout/steps/_macros.html.twig' as step %}
{% set status = not state.identityCompleted ? 'locked' : (state.addressCompleted and state.currentStep != 2 ? 'done' : (state.currentStep == 2 ? 'current' : 'locked')) %}
<section class="space-y-4 rounded-lg p-4 {{ status == 'current' ? 'border-2 border-primary' : 'border border-secondary/40' }}" data-step-status="{{ status }}">
    {{ step.header('checkout.step.address'|trans, status, 'editAddress') }}

    {% if not state.identityCompleted %}
        {# Étape verrouillée : seul son titre s'affiche, comme la maquette #}

    {% elseif state.addressCompleted and state.currentStep != 2 %}
        <div class="text-sm">
            <div class="font-medium">
                {{ state.deliveryAddress.firstName ?? '' }} {{ state.deliveryAddress.lastName ?? '' }}
            </div>
            <div>{{ state.deliveryAddress.address1 ?? '' }}</div>
            <div>{{ state.deliveryAddress.postcode ?? '' }} {{ state.deliveryAddress.city ?? '' }}</div>
            <div>{{ (state.deliveryAddress.country ?? null)|country|trans }}</div>
        </div>

        <div class="space-y-3 border-t border-secondary/30 pt-4">
            <label class="flex items-center gap-2 text-sm">
                <input
                    type="checkbox"
                    {% if state.billingSameAsDelivery %}checked{% endif %}
                    data-action="live#action"
                    data-live-action-param="toggleBillingSameAsDelivery"
                    data-live-same-as-delivery-param="{{ state.billingSameAsDelivery ? 'false' : 'true' }}"
                >
                {{ 'checkout.address.same_billing'|trans }}
            </label>

            {% if not state.billingSameAsDelivery %}
                {% if state.billingCompleted %}
                    <div class="flex items-center justify-between gap-4">
                        <div class="text-sm">
                            <div class="font-medium">
                                {{ state.billingAddress.firstName ?? '' }} {{ state.billingAddress.lastName ?? '' }}
                            </div>
                            <div>{{ state.billingAddress.address1 ?? '' }}</div>
                            <div>{{ state.billingAddress.postcode ?? '' }} {{ state.billingAddress.city ?? '' }}</div>
                            <div>{{ (state.billingAddress.country ?? null)|country|trans }}</div>
                        </div>

                        <button
                            type="button"
                            data-action="live#action"
                            data-live-action-param="useNewBillingAddressForm"
                            class="border-2 border-primary bg-white px-5 py-2 text-primary hover:bg-paragraph"
                        >
                            {{ 'checkout.step.edit'|trans }}
                        </button>
                    </div>
                {% else %}
                    {% if shouldShowBillingAddressSelection %}
                        <div class="grid gap-4 md:grid-cols-2">
                            {% for address in savedBillingAddresses %}
                                <button
                                    type="button"
                                    class="block w-full rounded-lg border border-secondary/40 bg-white p-4 text-left text-ink hover:border-primary hover:bg-paragraph"
                                    data-action="live#action"
                                    data-live-action-param="selectBillingAddress"
                                    data-live-address-id-param="{{ address.id }}"
                                >
                                    <div class="flex items-center justify-between gap-2">
                                        <div class="font-medium">{{ address.label }}</div>
                                        {% if address.isDefault %}
                                            <span class="rounded border border-secondary/40 px-2 py-1 text-xs">{{ 'checkout.address.default'|trans }}</span>
                                        {% endif %}
                                    </div>

                                    <div class="mt-3 text-sm">
                                        <div>{{ address.firstName }} {{ address.lastName }}</div>
                                        <div>{{ address.address1 }}</div>
                                        <div>{{ address.postcode }} {{ address.city }}</div>
                                        <div>{{ address.country|country|trans }}</div>
                                    </div>
                                </button>
                            {% endfor %}
                        </div>

                        <div>
                            <button
                                type="button"
                                data-action="live#action"
                                data-live-action-param="useNewBillingAddressForm"
                                class="border-2 border-primary bg-white px-5 py-2 text-primary hover:bg-paragraph"
                            >
                                {{ 'checkout.address.new'|trans }}
                            </button>
                        </div>
                    {% endif %}

                    {% if shouldShowBillingAddressForm %}
                        <div data-live-update-on="billing-address-form-update">
                            {{ form_start(form, {
                                attr: {
                                    'data-model': 'on(change)|*',
                                    'data-action': 'submit->live#action:prevent',
                                    'data-live-action-param': 'saveBillingAddress'
                                }
                            }) }}
                            <div class="grid gap-4 md:grid-cols-2">
                                {{ form_row(form.label) }}
                                <div></div>
                                {{ form_row(form.firstName) }}
                                {{ form_row(form.lastName) }}
                                {{ form_row(form.address1) }}
                                {{ form_row(form.postcode) }}
                                {{ form_row(form.city) }}
                                {{ form_row(form.country) }}
                            </div>

                            <button type="submit" class="mt-4">
                                {{ 'checkout.address.save_billing'|trans }}
                            </button>
                            {{ form_end(form) }}
                        </div>
                    {% endif %}
                {% endif %}
            {% endif %}
        </div>

    {% elseif state.currentStep == 2 %}
        {% if shouldShowAddressSelection %}
            <div class="grid gap-4 md:grid-cols-2">
                {% for address in savedDeliveryAddresses %}
                    <button
                        type="button"
                        class="block w-full rounded-lg border border-secondary/40 bg-white p-4 text-left text-ink hover:border-primary hover:bg-paragraph"
                        data-action="live#action"
                        data-live-action-param="selectDeliveryAddress"
                        data-live-address-id-param="{{ address.id }}"
                    >
                        <div class="flex items-center justify-between gap-2">
                            <div class="font-medium">{{ address.label }}</div>
                            {% if address.isDefault %}
                                <span class="rounded border border-secondary/40 px-2 py-1 text-xs">{{ 'checkout.address.default'|trans }}</span>
                            {% endif %}
                        </div>

                        <div class="mt-3 text-sm">
                            <div>{{ address.firstName }} {{ address.lastName }}</div>
                            <div>{{ address.address1 }}</div>
                            <div>{{ address.postcode }} {{ address.city }}</div>
                            <div>{{ address.country|country|trans }}</div>
                        </div>
                    </button>
                {% endfor %}
            </div>

            <div>
                <button
                    type="button"
                    data-action="live#action"
                    data-live-action-param="useNewAddressForm"
                    class="border-2 border-primary bg-white px-5 py-2 text-primary hover:bg-paragraph"
                >
                    {{ 'checkout.address.new'|trans }}
                </button>
            </div>
        {% endif %}

        {% if shouldShowAddressForm %}
            <div data-live-update-on="address-form-update">
                {{ form_start(form, {
                    attr: {
                        'data-model': 'on(change)|*',
                        'data-action': 'submit->live#action:prevent',
                        'data-live-action-param': 'saveAddress'
                    }
                }) }}
                <div class="grid gap-4 md:grid-cols-2">
                    {{ form_row(form.label) }}
                    <div></div>
                    {{ form_row(form.firstName) }}
                    {{ form_row(form.lastName) }}
                    {{ form_row(form.address1) }}
                    {{ form_row(form.postcode) }}
                    {{ form_row(form.city) }}
                    {{ form_row(form.country) }}
                </div>

                <button type="submit" class="mt-4">
                    {{ 'checkout.address.save'|trans }}
                </button>
                {{ form_end(form) }}
            </div>
        {% endif %}
    {% endif %}
</section>
