{% import 'components/Checkout/steps/_macros.html.twig' as step %}
{% set status = state.identityCompleted and state.currentStep != 1 ? 'done' : 'current' %}
<section class="space-y-4 rounded-lg p-4 {{ status == 'current' ? 'border-2 border-primary' : 'border border-secondary/40' }}" data-step-status="{{ status }}">
    {{ step.header('checkout.step.identity'|trans, status, isAuthenticatedStepSkipped ? null : 'editIdentity') }}

    {% if state.identityCompleted and state.currentStep != 1 %}
        <div class="text-sm">
            <div class="font-medium">
                {{ state.identity.firstName ?? '' }} {{ state.identity.lastName ?? '' }}
            </div>
            <div>{{ state.identity.email ?? '' }}</div>
            {% if isAuthenticatedStepSkipped %}
                <div class="text-xs text-success">{{ 'checkout.identity.logged_in'|trans }}</div>
            {% endif %}
        </div>
    {% else %}
        {# Le mode choisi est plein, l'autre en contour. Avant tout choix, l'invité est mis en avant, comme la maquette #}
        <div class="flex flex-wrap items-center gap-3">
            <button
                type="button"
                data-action="live#action"
                data-live-action-param="chooseGuest"
                aria-pressed="{{ state.identityMode == 'guest' ? 'true' : 'false' }}"
                class="{{ state.identityMode == 'login' ? 'border-2 border-primary bg-white px-5 py-2 text-primary hover:bg-paragraph' : '' }}"
            >
                {{ 'checkout.identity.guest'|trans }}
            </button>

            <button
                type="button"
                data-action="live#action"
                data-live-action-param="chooseLogin"
                aria-pressed="{{ state.identityMode == 'login' ? 'true' : 'false' }}"
                class="{{ state.identityMode == 'login' ? '' : 'border-2 border-primary bg-white px-5 py-2 text-primary hover:bg-paragraph' }}"
            >
                {{ 'checkout.identity.login'|trans }}
            </button>
        </div>

        {% if state.identityMode == 'guest' %}
            {{ form_start(form, {
                attr: {
                    'data-model': 'on(change)|*',
                    'data-action': 'live#action:prevent',
                    'data-live-action-param': 'saveGuest'
                }
            }) }}
            <div class="grid gap-4 md:grid-cols-2">
                {# Civilité : les deux choix collés (○M.○Mme) sans cet espacement #}
                {{ form_row(form.title, {attr: {class: 'flex flex-wrap items-center gap-x-2 gap-y-1 [&>label]:mr-4'}}) }}
                <div></div>
                {{ form_row(form.firstName) }}
                {{ form_row(form.lastName) }}
                {{ form_row(form.email) }}
                {{ form_row(form.password) }}
            </div>

            <button type="submit" class="mt-4">
                {{ 'checkout.identity.continue'|trans }}
            </button>
            {{ form_end(form) }}

        {% elseif state.identityMode == 'login' %}
            {% if loginError %}
                <div class="rounded border border-red-300 bg-red-50 p-3 text-sm text-danger">
                    {{ loginError|trans([], 'security') }}
                </div>
            {% endif %}

            <form action="{{ path('app.login') }}" method="post" class="space-y-4">
                <div>
                    <label for="checkout_login_email" class="mb-1 block text-sm font-medium">{{ 'checkout.form.email'|trans }}</label>
                    <input
                        id="checkout_login_email"
                        type="email"
                        name="_username"
                        value="{{ lastUsername }}"
                        class="w-full rounded border px-3 py-2"
                        autocomplete="email"
                    >
                </div>

                <div>
                    <label for="checkout_login_password" class="mb-1 block text-sm font-medium">{{ 'checkout.identity.password'|trans }}</label>
                    <input
                        id="checkout_login_password"
                        type="password"
                        name="_password"
                        class="w-full rounded border px-3 py-2"
                        autocomplete="current-password"
                    >
                </div>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                <input type="hidden" name="_target_path" value="{{ path('checkout.index') }}">

                <button type="submit">
                    {{ 'checkout.identity.login'|trans }}
                </button>
            </form>
        {% else %}
            <div class="text-sm text-muted">
                {{ 'checkout.identity.choose'|trans }}
            </div>
        {% endif %}
    {% endif %}
</section>
