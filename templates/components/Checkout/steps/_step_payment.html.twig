<section class="rounded-lg border p-4 space-y-4">
    <h2 class="text-lg font-semibold">4. Paiement</h2>

    {% if paymentNotices is not empty %}
        <ul class="flash-warning space-y-1 text-sm" role="alert">
            {% for notice in paymentNotices %}
                <li>{{ notice }}</li>
            {% endfor %}
        </ul>
    {% endif %}

    {% if not state.deliveryCompleted %}
        <div class="text-sm text-muted">
            Complète d'abord la livraison.
        </div>
    {% elseif state.currentStep == 4 %}
        <fieldset class="space-y-3">
            <legend class="font-medium">Choisissez votre moyen de paiement :</legend>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                {% for method, label in availablePaymentMethods %}
                    {# Vrais boutons radio, stylés en boutons : le choix reste un groupe au clavier et au lecteur d'écran #}
                    <label class="flex cursor-pointer items-center justify-center gap-2 rounded-lg border border-primary bg-white px-4 py-3 font-title font-semibold text-primary transition-colors has-[:checked]:bg-primary has-[:checked]:text-paragraph has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-primary has-[:focus-visible]:ring-offset-2">
                        <input
                            type="radio"
                            name="payment_method"
                            value="{{ method }}"
                            class="sr-only"
                            {% if method == selectedPaymentMethod %}checked{% endif %}
                            data-action="change->live#action"
                            data-live-action-param="selectPaymentMethod"
                            data-live-method-param="{{ method }}"
                        >
                        {{ ux_icon(method == 'paypal' ? 'simple-icons:paypal' : 'lucide:credit-card', {height: '20px', width: '20px'}) }}
                        <span>{{ label }}</span>
                    </label>
                {% endfor %}
            </div>
        </fieldset>

        <p class="text-xs text-muted">
            Paiement sécurisé par Stripe : vos données bancaires ne transitent pas par HardWareHouse.
        </p>

        {# Désactivé pendant la requête : un double clic créait deux commandes et deux sessions Stripe #}
        <button
            type="button"
            data-action="live#action"
            data-live-action-param="processPayment"
            data-loading="attr(disabled)"
        >
            Payer {{ orderTotal|format_currency('EUR') }}
        </button>
    {% endif %}
</section>
