<section class="rounded-lg border p-4 space-y-4">
    <h2 class="text-lg font-semibold">4. Paiement</h2>

    {% if paymentNotices is not empty %}
        <ul class="flash-warning space-y-1 text-sm" role="alert">
            {% for notice in paymentNotices %}
                <li>{{ notice }}</li>
            {% endfor %}
        </ul>
    {% endif %}

    {% if not state.deliveryCompleted %}
        <div class="text-sm text-muted">
            Complète d'abord la livraison.
        </div>
    {% elseif state.currentStep == 4 %}
        <fieldset class="space-y-3">
            <legend class="font-medium">Choisissez votre moyen de paiement :</legend>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                {% for method in availablePaymentMethods %}
                    {# Boutons bascule plutôt que des boutons radio : Live Components recoche à chaque rendu tout
                       bouton radio cliqué qui n'est relié à aucun modèle, et le dernier de la page l'emportait #}
                    <button
                        type="button"
                        aria-pressed="{{ method == selectedPaymentMethod ? 'true' : 'false' }}"
                        class="border border-primary bg-white px-4 py-3 text-primary hover:bg-paragraph aria-pressed:bg-primary aria-pressed:text-paragraph aria-pressed:hover:bg-primary-dark"
                        data-action="live#action"
                        data-live-action-param="selectPaymentMethod"
                        data-live-method-param="{{ method.value }}"
                    >
                        {{ ux_icon(method.value == 'paypal' ? 'simple-icons:paypal' : 'lucide:credit-card', {height: '20px', width: '20px'}) }}
                        <span>{{ method|trans }}</span>
                    </button>
                {% endfor %}
            </div>
        </fieldset>

        <p class="text-xs text-muted">
            Paiement sécurisé par Stripe : vos données bancaires ne transitent pas par HardWareHouse.
        </p>

        {# Désactivé pendant la requête : un double clic créait deux commandes et deux sessions Stripe #}
        <button
            type="button"
            data-action="live#action"
            data-live-action-param="processPayment"
            data-loading="addAttribute(disabled)"
        >
            Payer {{ orderTotal|format_currency('EUR') }}
        </button>
    {% endif %}
</section>
