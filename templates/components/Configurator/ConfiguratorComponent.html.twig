<div {{ attributes }} class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[minmax(0,400px)_1fr]">
    {% set catalogueAvailable = this.catalogueAvailable %}

    <aside aria-labelledby="configurator-title" class="space-y-3 rounded-md bg-paragraph p-3">
        <h1 id="configurator-title" class="text-2xl font-title text-primary">{{ 'configurator.title'|trans }}</h1>

        <div class="flex flex-wrap items-center justify-between gap-2">
            <a href="{{ path('configuration.index') }}" class="rounded-md border-2 border-primary px-3 py-1.5 font-title text-primary transition-colors hover:bg-primary hover:text-paragraph">
                {{ 'configurator.my_configurations'|trans }}
            </a>
            <button type="button" data-action="live#action" data-live-action-param="startNew" class="inline-flex items-center gap-1 rounded-md bg-transparent px-2 py-1.5 text-sm font-semibold text-primary transition-colors hover:bg-primary/10">
                {{ ux_icon('heroicons:plus', {class: 'size-4', 'aria-hidden': 'true'}) }}
                {{ 'configurator.start_new'|trans }}
            </button>
        </div>

        <ul class="space-y-2">
            {% for entry in this.slots %}
                {% set slot = entry.slot %}
                {% set active = slot == this.slot %}
                {% set conflict = entry.rules|filter(rule => rule != 'missing') is not empty %}

                {% for line in entry.lines %}
                    {% set product = line.product %}
                    <li class="relative flex items-center gap-3 rounded-md border-2 bg-white p-2 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-primary {{ conflict ? 'border-danger' : 'border-primary' }}">
                        {% if product and product.thumbnail %}
                            <img src="{{ product.thumbnail|catalog_image }}" alt="" width="56" height="56" loading="lazy" class="size-14 shrink-0 rounded object-cover">
                        {% else %}
                            <span class="size-14 shrink-0 rounded bg-paragraph" aria-hidden="true"></span>
                        {% endif %}

                        <div class="min-w-0 flex-1">
                            <button type="button" data-action="live#action" data-live-action-param="selectSlot" data-live-slot-param="{{ slot.value }}" data-live-category-param="{{ product ? product.categorySlug : '' }}" class="block w-full bg-transparent p-0 text-left font-title text-primary after:absolute after:inset-0 hover:bg-transparent focus:ring-0 focus:ring-offset-0 focus-visible:outline-none">
                                <span class="sr-only">{{ 'configurator.slot_prefix'|trans({'%slot%': slot|trans}) }}</span>
                                {% if product %}
                                    {{ product.name }}
                                {% else %}
                                    {{ (catalogueAvailable ? 'configurator.removed_product' : 'configurator.chosen_product')|trans }}
                                {% endif %}
                            </button>
                            {% if product %}
                                <p class="flex flex-wrap gap-x-2 text-sm">
                                    {% if product.stock.quantity|default(0) > 0 %}
                                        <span class="text-success">{{ 'configurator.in_stock'|trans }}</span>
                                    {% else %}
                                        <span class="text-danger">{{ 'configurator.out_of_stock'|trans }}</span>
                                    {% endif %}
                                    <span class="font-semibold text-primary">{{ product.effectivePrice|ttc|format_currency('EUR') }}</span>
                                    {% if line.quantity > 1 %}
                                        <span class="text-muted">{{ 'configurator.quantity'|trans({'%quantity%': line.quantity}) }}</span>
                                    {% endif %}
                                </p>
                            {% endif %}
                        </div>

                        <button type="button" data-action="live#action" data-live-action-param="remove" data-live-slot-param="{{ slot.value }}" data-live-product-id-param="{{ line.productId }}" aria-label="{{ 'configurator.remove'|trans({'%name%': product ? product.name : slot|trans}) }}" class="relative z-10 rounded bg-transparent p-1 text-danger hover:bg-red-50">
                            {{ ux_icon('heroicons-solid:trash', {class: 'size-5', 'aria-hidden': 'true'}) }}
                        </button>
                    </li>
                {% endfor %}

                {% if entry.lines|length < slot.maxReferences %}
                    <li>
                        <button type="button" aria-pressed="{{ active ? 'true' : 'false' }}" data-action="live#action" data-live-action-param="selectSlot" data-live-slot-param="{{ slot.value }}" class="flex w-full items-center justify-between gap-2 rounded-md border-2 px-3 py-3 text-left font-title transition-colors {{ active ? 'border-primary bg-primary text-paragraph' : 'border-secondary bg-white text-primary hover:border-primary' }}">
                            <span>{{ entry.lines is empty ? slot|trans : 'configurator.add_drive'|trans }}</span>
                            {% if entry.lines is empty and catalogueAvailable and 'missing' not in entry.rules %}
                                <span class="text-xs font-normal">{{ 'configurator.optional'|trans }}</span>
                            {% endif %}
                        </button>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>

        <div class="flex flex-wrap items-center justify-end gap-3 pt-2">
            <p class="text-primary">
                {{ 'configurator.total'|trans }}
                <strong class="font-title text-2xl">{{ (this.total / 100)|format_currency('EUR') }}</strong>
            </p>
            {% set readyForCart = this.readyForCart %}
            <button type="button" data-action="live#action" data-live-action-param="addToCart" {{ readyForCart ? '' : 'disabled' }} class="rounded-md px-3 py-2 font-title transition-colors {{ readyForCart ? 'bg-primary text-paragraph hover:bg-primary-dark' : 'cursor-not-allowed bg-disabled text-muted' }}">
                {{ 'configurator.add_to_cart'|trans }}
            </button>
        </div>

        {% set missingCount = this.missingCount %}
        {% if catalogueAvailable and missingCount > 0 %}
            <p class="text-sm text-warning">{{ 'configurator.incomplete'|trans({'%count%': missingCount}) }}</p>
        {% endif %}

        {{ include('components/Configurator/_problems.html.twig', {problems: this.problems}, with_context = false) }}

        {% if this.notice %}
            <p role="status" class="text-sm text-success">
                {{ this.notice|trans }}
                <a href="{{ path('configuration.index') }}" class="font-semibold underline">{{ 'configurator.my_configurations'|trans }}</a>
            </p>
        {% endif %}
        {% if this.error %}
            {# Clé de traduction, ou message destiné au client levé par CartService, que trans rend tel quel #}
            <p role="alert" class="text-sm text-danger">{{ this.error|trans }}</p>
        {% endif %}

        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
            <div class="flex gap-2">
                <label for="configurator-name" class="sr-only">{{ 'configurator.save.name'|trans }}</label>
                {# norender : le nom part avec la sauvegarde, sans relire le catalogue à chaque frappe #}
                <input id="configurator-name" type="text" maxlength="100" data-model="norender|name" value="{{ this.name }}" placeholder="{{ 'configurator.save.name'|trans }}" class="min-w-0 flex-1 rounded-md border-2 border-secondary bg-white px-3 py-2 text-ink placeholder:text-muted focus:border-primary focus:outline-none">
                <button type="button" data-action="live#action" data-live-action-param="save" class="rounded-md border-2 border-primary bg-white px-3 py-2 font-title text-primary transition-colors hover:bg-primary hover:text-paragraph">
                    {{ 'configurator.save.submit'|trans }}
                </button>
            </div>
        {% else %}
            <button type="button" data-action="live#action" data-live-action-param="save" class="w-full rounded-md border-2 border-primary bg-white px-3 py-2 font-title text-primary transition-colors hover:bg-primary hover:text-paragraph">
                {{ 'configurator.save.login'|trans }}
            </button>
        {% endif %}
    </aside>

    <section aria-labelledby="configurator-list-title" class="space-y-3">
        {% set list = this.compatibleProducts %}
        <header class="flex flex-wrap items-center justify-between gap-3 rounded-md bg-paragraph p-4">
            <div>
                <h2 id="configurator-list-title" class="text-xl font-title text-primary">
                    {{ 'configurator.list.count'|trans({'%slot%': this.slot|trans, '%count%': list ? list.total : 0}) }}
                </h2>
                {% if list and list.filtered %}
                    <p class="text-sm text-muted">{{ 'configurator.list.filtered'|trans }}</p>
                {% endif %}
            </div>

            {% if this.slot.categorySlugs|length > 1 %}
                <div role="group" aria-label="{{ 'configurator.list.categories'|trans }}" class="flex gap-2">
                    {% for category in this.slot.categorySlugs %}
                        {% set current = category == this.category %}
                        <button type="button" aria-pressed="{{ current ? 'true' : 'false' }}" data-action="live#action" data-live-action-param="selectSlot" data-live-slot-param="{{ this.slot.value }}" data-live-category-param="{{ category }}" class="rounded-md border-2 border-primary px-3 py-1.5 font-title transition-colors {{ current ? 'bg-primary text-paragraph' : 'bg-white text-primary hover:bg-primary/10' }}">
                            {{ ('category.' ~ category)|trans }}
                        </button>
                    {% endfor %}
                </div>
            {% endif %}
        </header>

        {% if list is null %}
            <p role="alert" class="rounded-md bg-red-50 p-4 text-danger">{{ 'configurator.unavailable'|trans }}</p>
        {% elseif list.data is empty %}
            <p class="rounded-md bg-paragraph p-4 text-muted">{{ 'configurator.list.empty'|trans }}</p>
        {% else %}
            {% set chosenIds = this.state.lines(this.slot)|map(line => line.productId) %}
            <ul class="space-y-2 rounded-md bg-paragraph p-2" data-loading="addClass(opacity-50)">
                {% for product in list.data %}
                    {% set chosen = product.id in chosenIds %}
                    <li class="relative flex items-center gap-4 rounded-md border-2 bg-white p-2 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-primary {{ chosen ? 'border-primary' : 'border-transparent hover:border-secondary' }}">
                        {% if product.thumbnail %}
                            <img src="{{ product.thumbnail|catalog_image }}" alt="" width="96" height="96" loading="lazy" class="size-20 shrink-0 rounded object-cover sm:size-24">
                        {% else %}
                            <span class="size-20 shrink-0 rounded bg-paragraph sm:size-24" aria-hidden="true"></span>
                        {% endif %}

                        <div class="min-w-0 flex-1">
                            <h3 class="font-title text-lg text-primary">
                                {# Toute la carte est cliquable (after:inset-0), le bouton reste le seul élément interactif #}
                                <button type="button" aria-pressed="{{ chosen ? 'true' : 'false' }}" data-action="live#action" data-live-action-param="choose" data-live-product-id-param="{{ product.id }}" class="bg-transparent p-0 text-left font-title text-lg text-primary after:absolute after:inset-0 hover:bg-transparent focus:ring-0 focus:ring-offset-0 focus-visible:outline-none">
                                    {{ product.name }}
                                </button>
                            </h3>
                            {% if product.shortDescription %}
                                <p class="text-sm text-primary">{{ product.shortDescription }}</p>
                            {% endif %}
                        </div>

                        <div class="shrink-0 text-right">
                            {{ include('_partials/_product_price.html.twig', {product: product, class: 'flex flex-col items-end gap-1', price_class: 'font-title text-xl font-bold text-primary'}, with_context = false) }}
                            {% if product.stock.quantity|default(0) > 0 %}
                                <p class="text-sm font-semibold text-success">{{ 'configurator.in_stock'|trans }}</p>
                            {% else %}
                                <p class="text-sm font-semibold text-danger">{{ 'configurator.out_of_stock'|trans }}</p>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>

            {% if list.meta.totalPages > 1 %}
                <nav aria-label="{{ 'configurator.list.pagination'|trans }}" class="flex items-center justify-center gap-3">
                    <button type="button" data-action="live#action" data-live-action-param="goToPage" data-live-page-param="{{ list.meta.page - 1 }}" {{ list.meta.hasPrev ? '' : 'disabled' }} class="rounded-md border-2 border-primary bg-white px-3 py-1.5 font-title text-primary hover:bg-primary/10 disabled:border-disabled disabled:bg-disabled disabled:text-muted">
                        {{ 'configurator.list.previous'|trans }}
                    </button>
                    <span class="text-sm text-primary">{{ 'configurator.list.page'|trans({'%page%': list.meta.page, '%pages%': list.meta.totalPages}) }}</span>
                    <button type="button" data-action="live#action" data-live-action-param="goToPage" data-live-page-param="{{ list.meta.page + 1 }}" {{ list.meta.hasNext ? '' : 'disabled' }} class="rounded-md border-2 border-primary bg-white px-3 py-1.5 font-title text-primary hover:bg-primary/10 disabled:border-disabled disabled:bg-disabled disabled:text-muted">
                        {{ 'configurator.list.next'|trans }}
                    </button>
                </nav>
            {% endif %}
        {% endif %}
    </section>
</div>
